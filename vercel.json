{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/check-status.html",
      "dest": "/check_status.html"
    },
    {
      "src": "/check-status",
      "dest": "/check_status.html"
    },
    {
      "src": "/register",
      "dest": "/register.html"
    },
    {
      "src": "/science",
      "dest": "/science.html"
    },
    {
      "src": "/commerce",
      "dest": "/commerce.html"
    },
    {
      "src": "/it",
      "dest": "/it.html"
    },
    {
      "src": "/humanities",
      "dest": "/humanities.html"
    },
    {
      "src": "/about",
      "dest": "/about.html"
    },
    {
      "src": "/admin/dashboard",
      "dest": "/api/index.py"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/docs",
      "dest": "/api/index.py"
    },
    {
      "src": "/openapi.json",
      "dest": "/api/index.py"
    },
    {
      "handle": "filesystem"
    }
  ]
}
